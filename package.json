{
  "name": "chira-sweets",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:cms": "tinacms dev --noTelemetry -c \"next dev\"",
    "build:cms": "tinacms build --noTelemetry && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@tinacms/cli": "4.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tinacms": "3.15.2",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "4.160.1"
  },
  "engines": {
    "node": ">=22"
  }
}
